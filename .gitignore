cat > .gitignore << 'EOF'
# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/

# Environment files — comprehensive
.env
.env.local
.env.*.local
*.env
.env.sentry-build-plugin
*token.json*
*credentials.json*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# System
.DS_Store
*.pem
dump.rdb

# Python
__pycache__/
*.pyc
venv/
.venv/

# IDE
.idea/
.vscode/

# Deployment
.vercel

# Build caches
.cache/

# Archives
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
EOF